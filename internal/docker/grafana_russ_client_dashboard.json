        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "russ_client_writer_enqueuers_active",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
