{
  "title": "russ-client orders analytics",
  "uid": "russ-client-workload",
  "description": "Asynq-based e-commerce orders analytics engine. Writer enqueues order:process tasks; processor applies analytics aggregates atomically via a Lua script (counters, zsets, HLL, hourly buckets, leaderboards, market-basket pairs, new/returning split); api serves /api/analytics/* + /metrics. No individual orders are stored \u2014 only summaries. Dashboard covers every russ_client_* metric plus runtime collectors.",
  "tags": [
    "russ",
    "russ-client",
    "asynq",
    "orders",
    "analytics"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
