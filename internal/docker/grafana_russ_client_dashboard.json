    {
      "id": 7,
      "title": "Orders enqueued vs processed (per sec)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(russ_client_orders_enqueued_total[1m])",
          "refId": "A",
          "legendFormat": "enqueued/s"
        },
        {
          "expr": "rate(russ_client_orders_processed_total[1m])",
          "refId": "B",
          "legendFormat": "processed/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last"
          ]
