{
  "title": "Redis Sentinel",
  "uid": "russ-sentinel-fleet",
  "description": "Redis Sentinel fleet health: per-sentinel status, monitored master health (slave count, quorum, failover state), and sentinel instance metrics. Covers redis_sentinel_* metrics scraped via the redis-sentinels Prometheus job.",
  "tags": ["russ", "sentinel"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Sentinels v6",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(redis_sentinel_masters{job=\"redis-sentinels\", sentinel_version=\"6\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Sentinels v8",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(redis_sentinel_masters{job=\"redis-sentinels\", sentinel_version=\"8\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Masters OK",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (master_name) (redis_sentinel_master_status{job=\"redis-sentinels\", master_status=\"ok\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Masters Degraded",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (master_name) (redis_sentinel_master_status{job=\"redis-sentinels\", master_status!=\"ok\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "OK Slaves per Master",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "min by (master_name) (redis_sentinel_master_ok_slaves{job=\"redis-sentinels\"})",
          "refId": "A",
          "legendFormat": "{{master_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {"mode": "none"},
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last"]
        }
      }
    },
    {
      "id": 6,
      "title": "OK Sentinels per Master (quorum view)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "min by (master_name) (redis_sentinel_master_ok_sentinels{job=\"redis-sentinels\"})",
          "refId": "A",
          "legendFormat": "ok {{master_name}}"
        },
        {
          "expr": "min by (master_name) (redis_sentinel_master_sentinels{job=\"redis-sentinels\"})",
          "refId": "B",
          "legendFormat": "total {{master_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {"mode": "none"},
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last"]
        }
      }
    },
    {
      "id": 7,
      "title": "Master Last OK Ping (seconds ago)",
      "description": "Time elapsed since each sentinel last received a successful ping reply from the master. Spikes here indicate the sentinel is having trouble reaching the master and may trigger s_down/o_down.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "max by (master_name) (redis_sentinel_master_last_ok_ping_reply_seconds{job=\"redis-sentinels\"})",
          "refId": "A",
          "legendFormat": "{{master_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {"mode": "none"},
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        }
      }
    },
    {
      "id": 8,
      "title": "Connected Clients per Sentinel",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "russ-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "redis_connected_clients{job=\"redis-sentinels\"}",
          "refId": "A",
          "legendFormat": "{{sentinel_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
